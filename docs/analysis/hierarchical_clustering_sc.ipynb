      "source": [
        "## Perform clustering using t-distributed Stochastic Neighbor Embedding (t-SNE)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Perform t-SNE to reduce dimensions to 2D\n",
        "tsne = TSNE(n_components=2, random_state=random_seed)\n",
        "tsne_embedding = tsne.fit_transform(SC_matrices_tril)\n",
        "\n",
        "# TO DO: IMPLEMENT PCA TO REDUCE NBR OF FEATURES TO AROUND 50the documentation of t-SNE mention\n",
        "# It is highly recommended to use another dimensionality reduction method (e.g. PCA for dense data or TruncatedSVD for sparse data)\n",
        "# to reduce the number of dimensions to a reasonable amount (e.g. 50) if the number of features is very high. So we need to implement the PCA reduction before tSNE."
      ]
    },
